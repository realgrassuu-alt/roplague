-	self._win = { 0, 0, -1, -1 }
-	self._rlo = {} :: { number }
-	self._rhi = {} :: { number }
-	--- and per column the first and last row blurred across
-	self._cf = {} :: { number }
-	self._cl = {} :: { number }
-	--- label.Visible as last written
-	self._vis = false
